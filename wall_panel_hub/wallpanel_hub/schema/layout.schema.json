{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abdo0125/ha-wall-panel/schema/layout.schema.json",
  "title": "Wall panel layout, version 2",
  "description": "What one panel shows: pages of cards. Shared by the Android app, the ESP32 firmware and the management add-on; it never carries credentials. Which cards exist, what entities, sizes and options each accepts, is defined in cards.json and checked by the add-on on save.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "Layout format. Files without it are version 1 (tiles) and are migrated on read.",
      "const": 2
    },
    "version": {
      "description": "Layout revision. The add-on increments it on every change; a panel only applies a layout newer than the one it holds.",
      "type": "integer",
      "minimum": 1
    },
    "panel": {
      "$ref": "#/$defs/panel"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "dashboard": {
      "description": "My dashboard, the first entry of the sidebar: favourites from the panel's rooms, scenes, apps and the panel's own cards (widget.*). Omitted: the clock, then the panel's scenes.",
      "type": "object",
      "required": [
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    }
  },
  "$defs": {
    "panel": {
      "description": "Display settings of a panel without a hub (direct link). With a hub they come from the panel configuration (config.schema.json): the hub moves them there and leaves this out.",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "enum": [
            "ar",
            "fr",
            "en"
          ],
          "default": "ar"
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ],
          "default": "light"
        },
        "screensaver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 60
            },
            "dim_brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 10
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "title",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "floor": {
          "description": "The floor (an HA floor id) this room shows under on this panel; left out: its area's floor in HA.",
          "type": "string",
          "minLength": 1
        },
        "tile": {
          "description": "The room's card in the panel's rooms menu; left out: its picture at 2x1, laid out in order.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "card": {
              "enum": [
                "room.card",
                "room.summary"
              ]
            },
            "size": {
              "type": "string",
              "pattern": "^[1-4]x[1-4]$"
            },
            "pos": {
              "description": "Its place in its floor's grid in the rooms menu (screen, column, row, from the reading side). Omitted: laid out in order after the placed rooms.",
              "type": "object",
              "required": [
                "screen",
                "col",
                "row"
              ],
              "additionalProperties": false,
              "properties": {
                "screen": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "col": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "row": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                }
              }
            }
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "card",
        "entities"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique in the layout. Stays the same when the card is edited, moved or resized.",
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "card": {
          "description": "Card type from cards.json, as kind.variant (e.g. light.dimmer).",
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z_]+$"
        },
        "entities": {
          "description": "Home Assistant entity ids. How many, and of which domains, depends on the card type.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "uniqueItems": true
        },
        "size": {
          "description": "Grid cells, columns x rows. Omitted: the card type's default size.",
          "enum": [
            "1x1",
            "2x1",
            "2x2",
            "3x2",
            "4x2"
          ]
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "confirm": {
          "description": "Ask before sending the command. Defaults to true for lock cards.",
          "type": "boolean"
        },
        "options": {
          "description": "Card type options, as defined in cards.json.",
          "type": "object"
        },
        "pos": {
          "description": "Fixed place on the grid of a panel with free placement (Android): screen, column and row of the top-left cell, counted from the reading side. Omitted: laid out in order after the placed cards.",
          "type": "object",
          "required": [
            "screen",
            "col",
            "row"
          ],
          "additionalProperties": false,
          "properties": {
            "screen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "col": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            }
          }
        }
      }
    },
    "entity": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
    },
    "icon": {
      "description": "Material Design Icons name, as in Home Assistant (e.g. mdi:lightbulb).",
      "type": "string",
      "pattern": "^mdi:[a-z0-9-]+$"
    }
  }
}
