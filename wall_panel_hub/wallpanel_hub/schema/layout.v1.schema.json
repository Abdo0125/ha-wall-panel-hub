{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abdo0125/ha-wall-panel/schema/layout.v1.schema.json",
  "title": "Wall panel layout, version 1 (legacy)",
  "description": "Tile-based layout used up to add-on 0.4.0. Kept to read old files and to serve panels running an older app; new layouts use layout.schema.json (v2).",
  "type": "object",
  "required": [
    "version",
    "panel",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Layout revision. The add-on increments it on every change; a panel only applies a layout newer than the one it holds.",
      "type": "integer",
      "minimum": 1
    },
    "panel": {
      "$ref": "#/$defs/panel"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "enum": [
            "ar",
            "fr",
            "en"
          ],
          "default": "ar"
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ],
          "default": "dark"
        },
        "screensaver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 60
            },
            "dim_brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 10
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "title",
        "tiles"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tile"
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "required": [
        "type",
        "entity"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Tile kind. 'generic' renders any entity as on/off plus its state text.",
          "enum": [
            "light",
            "switch",
            "cover",
            "climate",
            "fan",
            "lock",
            "scene",
            "script",
            "button",
            "generic"
          ]
        },
        "entity": {
          "description": "Home Assistant entity_id.",
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "confirm": {
          "description": "Ask before sending the command. Defaults to true for lock tiles.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "light"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^light\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "switch"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^(switch|input_boolean)\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cover"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^cover\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "climate"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^climate\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fan"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^fan\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "lock"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^lock\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^scene\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "script"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^script\\."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "pattern": "^(button|input_button)\\."
              }
            }
          }
        }
      ]
    },
    "icon": {
      "description": "Material Design Icons name, as in Home Assistant (e.g. mdi:lightbulb).",
      "type": "string",
      "pattern": "^mdi:[a-z0-9-]+$"
    }
  }
}
