{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abdo0125/ha-wall-panel/schema/config.schema.json",
  "title": "Wall panel configuration",
  "description": "Behaviour and security, kept apart from the layout (what the panel shows). The add-on stores one 'site' document for the project and one 'panel' document per panel, and sends each panel the 'effective' merge of the two. Use the $defs: #/$defs/site, #/$defs/panel, #/$defs/effective.",
  "$defs": {
    "site": {
      "description": "Project-wide settings, edited in the add-on.",
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "installer_pin": {
          "$ref": "#/$defs/pin_or_none"
        },
        "user_pin": {
          "$ref": "#/$defs/pin_or_none"
        },
        "defaults": {
          "$ref": "#/$defs/settings"
        },
        "devices": {
          "$ref": "#/$defs/devices"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "floors": {
          "$ref": "#/$defs/floors"
        }
      }
    },
    "panel": {
      "description": "One panel's own settings. Anything left out comes from the site.",
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "overrides": {
          "$ref": "#/$defs/settings"
        },
        "installer_pin": {
          "$ref": "#/$defs/pin_hash",
          "description": "Replaces the site's installer PIN on this panel."
        },
        "user_pin": {
          "$ref": "#/$defs/pin_hash",
          "description": "Replaces the site's user PIN on this panel."
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "apps": {
          "$ref": "#/$defs/apps"
        },
        "access_known": {
          "description": "The permissions the add-on offered when access was saved. A newer one is not in this list and takes its default, so saving an older panel's access never turns it off.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "widgets": {
          "$ref": "#/$defs/android_widgets",
          "description": "Unused since 0.13.1: an allowed app's widgets are allowed."
        }
      }
    },
    "effective": {
      "description": "What the panel receives: site and panel merged, every field resolved.",
      "type": "object",
      "required": [
        "version",
        "name",
        "lang",
        "theme",
        "screensaver",
        "app_return_seconds",
        "installer_pin",
        "user_pin",
        "access",
        "apps"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "site.version + panel.version: grows whenever either changes.",
          "type": "integer",
          "minimum": 2
        },
        "name": {
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "screensaver": {
          "type": "object",
          "required": [
            "idle_seconds",
            "dim_brightness"
          ],
          "additionalProperties": false,
          "properties": {
            "idle_seconds": {
              "type": "integer",
              "minimum": 10
            },
            "dim_brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "home_title": {
          "description": "The home page's name on the panel; blank: My dashboard.",
          "type": "string",
          "maxLength": 40
        },
        "app_return_seconds": {
          "$ref": "#/$defs/return_seconds"
        },
        "installer_pin": {
          "$ref": "#/$defs/pin_or_none"
        },
        "user_pin": {
          "$ref": "#/$defs/pin_or_none"
        },
        "access": {
          "allOf": [
            {
              "$ref": "#/$defs/access"
            }
          ],
          "required": [
            "guest",
            "user",
            "installer"
          ]
        },
        "apps": {
          "$ref": "#/$defs/apps"
        },
        "devices": {
          "$ref": "#/$defs/devices"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "floors": {
          "$ref": "#/$defs/floors"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "screensaver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle_seconds": {
              "type": "integer",
              "minimum": 10
            },
            "dim_brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "home_title": {
          "description": "The home page's name on the panel; blank: My dashboard.",
          "type": "string",
          "maxLength": 40
        },
        "app_return_seconds": {
          "$ref": "#/$defs/return_seconds"
        },
        "floor_names": {
          "description": "Names given to HA's floors, by floor id; HA's name where none is given.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "floor_icons": {
          "description": "Icons given to HA's floors, by floor id; HA's (or one by level) where none is given.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^mdi:[a-z0-9-]+$"
          }
        }
      }
    },
    "devices": {
      "description": "What each device is, set once for the project and used by every panel: its type (for a shutter: garage, curtain, window...; HA's device_class names), and the name and icon shown. Anything left out comes from Home Assistant.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_]+[.][a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "icon": {
            "type": "string",
            "pattern": "^mdi:[a-z0-9-]+$"
          }
        }
      }
    },
    "lang": {
      "enum": [
        "ar",
        "fr",
        "en",
        "es"
      ]
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "return_seconds": {
      "description": "Idle time in another app before the panel comes back to the front.",
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "pin_hash": {
      "description": "PBKDF2-SHA256 of the PIN. The PIN itself is never stored or sent.",
      "type": "object",
      "required": [
        "algo",
        "iterations",
        "salt",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "algo": {
          "const": "pbkdf2_sha256"
        },
        "iterations": {
          "type": "integer",
          "minimum": 10000
        },
        "salt": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 16
        },
        "hash": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 32
        }
      }
    },
    "pin_or_none": {
      "oneOf": [
        {
          "$ref": "#/$defs/pin_hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "description": "settings is the older name for connection + display + brightness + system.",
      "enum": [
        "control",
        "apps",
        "edit_cards",
        "reorder",
        "dashboard",
        "add_widgets",
        "connection",
        "display",
        "brightness",
        "system",
        "settings",
        "rooms",
        "devices",
        "panel",
        "project"
      ]
    },
    "access": {
      "description": "What can be done on the panel: without a PIN (guest), with the user PIN, with the installer PIN. rooms, devices, panel and project: what the add-on edits, from the panel too (docs/parity.md).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guest": {
          "$ref": "#/$defs/capabilities"
        },
        "user": {
          "$ref": "#/$defs/capabilities"
        },
        "installer": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "uniqueItems": true
    },
    "apps": {
      "description": "Other Android apps the panel may open.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package"
        ],
        "additionalProperties": false,
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
          },
          "label": {
            "type": "string"
          },
          "return_seconds": {
            "$ref": "#/$defs/return_seconds"
          }
        }
      }
    },
    "floors": {
      "description": "Home Assistant's floors in level order, each with its areas; read from HA by the add-on, not edited. The panel's rooms menu groups the pages (an area's page has its id) by them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "areas"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "description": "Where the built-in widgets read from, set once for the project. A widget added on a panel takes its entity from here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weather": {
          "type": "string",
          "pattern": "^weather\\.[a-z0-9_]+$"
        },
        "outdoor_temperature": {
          "type": "string",
          "pattern": "^sensor\\.[a-z0-9_]+$"
        },
        "power": {
          "type": "string",
          "pattern": "^sensor\\.[a-z0-9_]+$"
        }
      }
    },
    "android_widgets": {
      "description": "Widgets of the panel's installed apps it may show (Android panels), by provider: package/class.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+/[A-Za-z0-9_.$]+$"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
