{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abdo0125/ha-wall-panel/schema/config.schema.json",
  "title": "Wall panel configuration",
  "description": "Behaviour and security, kept apart from the layout (what the panel shows). The add-on stores one 'site' document for the project and one 'panel' document per panel, and sends each panel the 'effective' merge of the two. Use the $defs: #/$defs/site, #/$defs/panel, #/$defs/effective.",
  "$defs": {
    "site": {
      "description": "Project-wide settings, edited in the add-on.",
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "installer_pin": { "$ref": "#/$defs/pin_or_none" },
        "user_pin": { "$ref": "#/$defs/pin_or_none" },
        "defaults": { "$ref": "#/$defs/settings" },
        "devices": { "$ref": "#/$defs/devices" }
      }
    },
    "panel": {
      "description": "One panel's own settings. Anything left out comes from the site.",
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "overrides": { "$ref": "#/$defs/settings" },
        "installer_pin": { "$ref": "#/$defs/pin_hash", "description": "Replaces the site's installer PIN on this panel." },
        "user_pin": { "$ref": "#/$defs/pin_hash", "description": "Replaces the site's user PIN on this panel." },
        "access": { "$ref": "#/$defs/access" },
        "apps": { "$ref": "#/$defs/apps" }
      }
    },
    "effective": {
      "description": "What the panel receives: site and panel merged, every field resolved.",
      "type": "object",
      "required": ["version", "name", "lang", "theme", "screensaver", "app_return_seconds", "installer_pin", "user_pin", "access", "apps"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "site.version + panel.version: grows whenever either changes.",
          "type": "integer",
          "minimum": 2
        },
        "name": { "type": "string" },
        "lang": { "$ref": "#/$defs/lang" },
        "theme": { "$ref": "#/$defs/theme" },
        "screensaver": {
          "type": "object",
          "required": ["idle_seconds", "dim_brightness"],
          "additionalProperties": false,
          "properties": {
            "idle_seconds": { "type": "integer", "minimum": 10 },
            "dim_brightness": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "app_return_seconds": { "$ref": "#/$defs/return_seconds" },
        "installer_pin": { "$ref": "#/$defs/pin_or_none" },
        "user_pin": { "$ref": "#/$defs/pin_or_none" },
        "access": {
          "allOf": [{ "$ref": "#/$defs/access" }],
          "required": ["guest", "user", "installer"]
        },
        "apps": { "$ref": "#/$defs/apps" },
        "devices": { "$ref": "#/$defs/devices" }
      }
    },

    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang": { "$ref": "#/$defs/lang" },
        "theme": { "$ref": "#/$defs/theme" },
        "screensaver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle_seconds": { "type": "integer", "minimum": 10 },
            "dim_brightness": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "app_return_seconds": { "$ref": "#/$defs/return_seconds" }
      }
    },
    "devices": {
      "description": "What each device is, set once for the project and used by every panel: its type (for a shutter: garage, curtain, window...; HA's device_class names), and the name and icon shown. Anything left out comes from Home Assistant.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+[.][a-z0-9_]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "icon": { "type": "string", "pattern": "^mdi:[a-z0-9-]+$" }
        }
      }
    },
    "lang": { "enum": ["ar", "fr", "en"] },
    "theme": { "enum": ["dark", "light"] },
    "return_seconds": {
      "description": "Idle time in another app before the panel comes back to the front.",
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "pin_hash": {
      "description": "PBKDF2-SHA256 of the PIN. The PIN itself is never stored or sent.",
      "type": "object",
      "required": ["algo", "iterations", "salt", "hash"],
      "additionalProperties": false,
      "properties": {
        "algo": { "const": "pbkdf2_sha256" },
        "iterations": { "type": "integer", "minimum": 10000 },
        "salt": { "type": "string", "contentEncoding": "base64", "minLength": 16 },
        "hash": { "type": "string", "contentEncoding": "base64", "minLength": 32 }
      }
    },
    "pin_or_none": {
      "oneOf": [{ "$ref": "#/$defs/pin_hash" }, { "type": "null" }]
    },
    "capability": {
      "enum": ["control", "apps", "edit_cards", "reorder", "settings"]
    },
    "access": {
      "description": "What can be done on the panel: without a PIN (guest), with the user PIN, with the installer PIN. Adding or removing entities, pages or rooms is never possible on the panel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guest": { "$ref": "#/$defs/capabilities" },
        "user": { "$ref": "#/$defs/capabilities" },
        "installer": { "$ref": "#/$defs/capabilities" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "uniqueItems": true
    },
    "apps": {
      "description": "Other Android apps the panel may open.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package"],
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
          "label": { "type": "string" },
          "return_seconds": { "$ref": "#/$defs/return_seconds" }
        }
      }
    }
  }
}
