{
  "$comment": "Card registry. One card per function: a kind's main card is named as the kind (light, cover...), its other cards kind.name (scene.bar, room.card); what a device can do (dimming, colours, tilt, speeds) comes from Home Assistant, what the installer chooses is an option. free_size: any WxH up to the grid (6x4), sizes then only offered as presets. The add-on validates layouts against it and builds the editor's card picker and property fields from it; the app mirrors the kinds in CardKind.kt (a unit test keeps them in step). entities.domains '*' accepts any domain. Options of type 'entity' must be named *_entity. An option with 'requires' is offered only for a card of one device that can do it (dimming: a light with a colour mode other than on/off; speeds: a fan with HA's SET_SPEED feature).",
  "version": 2,
  "sizes": [
    "1x1",
    "2x1",
    "2x2",
    "3x2",
    "4x2"
  ],
  "targets": [
    "android",
    "esp32",
    "phone"
  ],
  "kinds": {
    "light": {
      "domains": [
        "light"
      ],
      "default": "light",
      "controllable": true
    },
    "switch": {
      "domains": [
        "switch",
        "input_boolean"
      ],
      "default": "switch",
      "controllable": true
    },
    "cover": {
      "domains": [
        "cover"
      ],
      "default": "cover",
      "controllable": true
    },
    "climate": {
      "domains": [
        "climate"
      ],
      "default": "climate",
      "controllable": true
    },
    "fan": {
      "domains": [
        "fan"
      ],
      "default": "fan",
      "controllable": true
    },
    "lock": {
      "domains": [
        "lock"
      ],
      "default": "lock",
      "controllable": true
    },
    "scene": {
      "domains": [
        "scene"
      ],
      "default": "scene",
      "controllable": true
    },
    "script": {
      "domains": [
        "script"
      ],
      "default": "script",
      "controllable": true
    },
    "button": {
      "domains": [
        "button",
        "input_button"
      ],
      "default": "button",
      "controllable": true
    },
    "sensor": {
      "domains": [
        "sensor",
        "binary_sensor",
        "automation"
      ],
      "default": "sensor",
      "controllable": false
    },
    "camera": {
      "domains": [
        "camera"
      ],
      "default": "camera",
      "controllable": true
    },
    "app": {
      "domains": [],
      "default": "app.launch",
      "controllable": false
    },
    "widget": {
      "domains": [
        "weather"
      ],
      "default": "widget.weather",
      "controllable": false
    },
    "room": {
      "domains": [],
      "default": "room.card",
      "controllable": false
    }
  },
  "cards": {
    "light": {
      "entities": {
        "min": 1,
        "max": 12
      },
      "sizes": [
        "1x1",
        "2x1",
        "2x2"
      ],
      "default_size": "1x1",
      "options": {
        "dimming": {
          "type": "bool",
          "default": true,
          "requires": "dimming"
        }
      },
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "switch": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "options": {
        "power_entity": {
          "type": "entity",
          "domains": [
            "sensor"
          ]
        }
      },
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "cover": {
      "entities": {
        "min": 1,
        "max": 12
      },
      "sizes": [
        "1x1",
        "2x1",
        "2x2"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
