{
  "$comment": "Card registry. The add-on validates layouts against it and builds the editor's card picker and property fields from it; the app mirrors the kinds in CardKind.kt (a unit test keeps them in step). entities.domains '*' accepts any domain. Options of type 'entity' must be named *_entity.",
  "version": 1,
  "sizes": [
    "1x1",
    "2x1",
    "2x2"
  ],
  "targets": [
    "android",
    "esp32",
    "phone"
  ],
  "kinds": {
    "light": {
      "domains": [
        "light"
      ],
      "default": "light.toggle",
      "controllable": true
    },
    "switch": {
      "domains": [
        "switch",
        "input_boolean"
      ],
      "default": "switch.toggle",
      "controllable": true
    },
    "cover": {
      "domains": [
        "cover"
      ],
      "default": "cover.buttons",
      "controllable": true
    },
    "climate": {
      "domains": [
        "climate"
      ],
      "default": "climate.compact",
      "controllable": true
    },
    "fan": {
      "domains": [
        "fan"
      ],
      "default": "fan.toggle",
      "controllable": true
    },
    "lock": {
      "domains": [
        "lock"
      ],
      "default": "lock.lock",
      "controllable": true
    },
    "scene": {
      "domains": [
        "scene"
      ],
      "default": "scene.action",
      "controllable": true
    },
    "script": {
      "domains": [
        "script"
      ],
      "default": "script.action",
      "controllable": true
    },
    "button": {
      "domains": [
        "button",
        "input_button"
      ],
      "default": "button.action",
      "controllable": true
    },
    "sensor": {
      "domains": [
        "sensor",
        "binary_sensor",
        "automation"
      ],
      "default": "sensor.value",
      "controllable": false
    },
    "app": {
      "domains": [],
      "default": "app.launch",
      "controllable": false
    },
    "widget": {
      "domains": [],
      "default": "widget.clock",
      "controllable": false
    }
  },
  "cards": {
    "light.toggle": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1",
        "2x2"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "light.dimmer": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ],
      "options": {
        "min_brightness": {
          "type": "int",
          "min": 1,
          "max": 100,
          "default": 1
        },
        "show_percent": {
          "type": "bool",
          "default": true
        }
      }
    },
    "light.color": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x2"
      ],
      "default_size": "2x2",
      "targets": [
        "android",
        "phone"
      ]
    },
    "light.group": {
      "entities": {
        "min": 2,
        "max": 12
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ],
      "options": {
        "dimmer": {
          "type": "bool",
          "default": false
        }
      }
    },
    "switch.toggle": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "switch.outlet": {
      "entities": {
        "min": 1,
        "max": 1,
        "domains": [
          "switch"
        ]
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ],
      "options": {
        "power_entity": {
          "type": "entity",
          "domains": [
            "sensor"
          ]
        }
      }
    },
    "cover.buttons": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1",
        "2x2"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "cover.position": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "cover.tilt": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "phone"
      ]
    },
    "cover.group": {
      "entities": {
        "min": 2,
        "max": 12
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "climate.compact": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "climate.thermostat": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x2"
      ],
      "default_size": "2x2",
      "targets": [
        "android",
        "phone"
      ],
      "options": {
        "step": {
          "type": "enum",
          "values": [
            "0.5",
            "1"
          ],
          "default": "0.5"
        }
      }
    },
    "fan.toggle": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "fan.speed": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x1"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "lock.lock": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "scene.action": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "scene.bar": {
      "entities": {
        "min": 2,
        "max": 6
      },
      "sizes": [
        "2x1"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "script.action": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "button.action": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "sensor.value": {
      "entities": {
        "min": 1,
        "max": 1,
        "domains": [
          "*"
        ]
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "sensor.multi": {
      "entities": {
        "min": 2,
        "max": 4,
        "domains": [
          "sensor"
        ]
      },
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default_size": "2x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "sensor.binary": {
      "entities": {
        "min": 1,
        "max": 1,
        "domains": [
          "binary_sensor"
        ]
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "app.launch": {
      "entities": {
        "min": 0,
        "max": 0
      },
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default_size": "1x1",
      "targets": [
        "android"
      ],
      "options": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
          "required": true
        },
        "return_seconds": {
          "type": "int",
          "min": 30,
          "max": 3600
        }
      }
    },
    "widget.clock": {
      "entities": {
        "min": 0,
        "max": 0
      },
      "sizes": [
        "2x2",
        "2x1"
      ],
      "default_size": "2x2",
      "targets": [
        "android"
      ]
    }
  }
}
