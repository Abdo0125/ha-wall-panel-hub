        "sensor",
        "binary_sensor",
        "automation"
      ],
      "default": "sensor",
      "controllable": false
    },
    "camera": {
      "domains": [
        "camera"
      ],
      "default": "camera",
      "controllable": true
    },
    "app": {
      "domains": [],
      "default": "app.launch",
      "controllable": false
    },
    "widget": {
      "domains": [
        "weather"
      ],
      "default": "widget.weather",
      "controllable": false
    },
    "room": {
      "domains": [],
      "default": "room.card",
      "controllable": false
    }
  },
  "cards": {
    "light": {
      "entities": {
        "min": 1,
        "max": 12
      },
      "sizes": [
        "2x2",
        "4x2",
        "4x4"
      ],
      "default_size": "2x2",
      "min_size": "1x1",
      "free_size": true,
      "options": {
        "fixture": {
          "type": "enum",
          "values": [
            "ceiling",
            "pendant",
            "spot",
            "strip",
            "wall",
            "floor",
            "table",
            "chandelier",
            "panel"
          ]
        },
        "on_color": {
          "type": "enum",
          "values": [
            "amber",
            "warm",
            "neutral",
            "cool",
            "red",
            "green",
            "blue",
            "violet"
          ],
          "default": "amber",
          "requires": "plain",
          "all_devices": true
        },
        "on_look": {
          "or_empty": "modes",
          "type": "enum",
          "values": [
            "glow",
            "cone"
          ],
          "default": "glow",
          "requires": "onoff",
          "all_devices": true
        },
        "modes": {
          "type": "set",
          "values": [
            "brightness",
            "white",
            "color"
          ],
          "value_requires": {
            "brightness": "dimming",
            "white": "white",
            "color": "color"
          }
        },
        "start_mode": {
          "type": "enum",
          "values": [
            "brightness",
            "white",
            "color"
          ],
          "default": "brightness",
          "of": "modes",
          "not_when": "lamp_bars"
        },
        "show_values": {
          "requires": "dimming",
          "any_device": true,
          "not_empty": "modes",
          "type": "bool",
          "default": true
        },
        "lamp_bars": {
          "requires": "dimming",
          "any_device": true,
          "not_empty": "modes",
          "from_size": "3x2",
          "to_size": "12x3",
          "type": "bool",
          "default": true
        },
        "lamp_look": {
          "only_when": "lamp_bars",
          "type": "enum",
          "values": [
            "glow",
            "cone"
          ],
          "default": "cone"
        },
        "long_press": {
          "type": "bool",
          "default": true
        },
        "group_members": {
          "type": "bool",
          "default": true,
          "requires": "group"
        }
      },
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "switch": {
      "entities": {
        "min": 1,
        "max": 1
      },
      "sizes": [
        "2x2",
        "4x2"
      ],
      "default_size": "2x2",
      "min_size": "1x1",
      "free_size": true,
      "options": {
        "power_entity": {
          "type": "entity",
          "domains": [
            "sensor"
          ]
        }
      },
      "targets": [
        "android",
        "esp32",
        "phone"
      ]
    },
    "cover": {
      "entities": {
        "min": 1,
